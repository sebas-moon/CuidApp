<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_bienvenida"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:layout_marginBottom="32dp"
                android:layout_marginTop="16dp"/>

            <!-- Tarjeta de Navegación (Intents Explícitos) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/chip_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFicha"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/menu_ficha"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/accent_purple"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExpedientes"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/menu_expedientes"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/accent_purple"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMonitoreo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/menu_monitoreo"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/accent_purple"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de Servicios Externos (Intents Implícitos) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/chip_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHospital"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/menu_hospital"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/btn_green"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWeb"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/menu_web"
                        android:textColor="@color/text_primary"
                        app:backgroundTint="@color/btn_blue"
                        app:cornerRadius="16dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>