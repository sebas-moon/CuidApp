<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    tools:context=".DashboardActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_health"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- NUEVO: Tarjeta del ritmo cardíaco en vivo (la actualiza el BroadcastReceiver) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_bpm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/chip_background"
                app:layout_constraintTop_toBottomOf="@id/tv_header_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_bpm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="@string/bpm_esperando"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Tarjeta de anillos de actividad -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_activity_rings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/chip_background"
                app:layout_constraintTop_toBottomOf="@id/card_bpm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- Gráfico de 3 anillos concéntricos (100% XML, sin librerías) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_rings_container"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:contentDescription="@string/cd_anillos"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!-- Anillo exterior: Calorías -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ring_move"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="75"
                            app:indicatorColor="@color/accent_move"
                            app:indicatorSize="140dp"
                            app:trackColor="@color/chip_background"
                            app:trackCornerRadius="6dp"
                            app:trackThickness="12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Anillo medio: Ejercicio -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ring_exercise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="50"
                            app:indicatorColor="@color/accent_exercise"
                            app:indicatorSize="108dp"
                            app:trackColor="@color/chip_background"
                            app:trackCornerRadius="6dp"
                            app:trackThickness="12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Anillo interior: Tiempo de pie -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/ring_stand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="80"
                            app:indicatorColor="@color/accent_stand"
                            app:indicatorSize="76dp"
                            app:trackColor="@color/chip_background"
                            app:trackCornerRadius="6dp"
                            app:trackThickness="12dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Flow: reparte las 3 métricas y 2 separadores en una fila -->
                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/flow_metrics"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:constraint_referenced_ids="metric_move,divider1,metric_exercise,divider2,metric_stand"
                        app:flow_horizontalStyle="spread_inside"
                        app:flow_wrapMode="none"
                        app:layout_constraintTop_toBottomOf="@id/layout_rings_container"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Métrica: Calorías -->
                    <LinearLayout
                        android:id="@+id/metric_move"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_move"
                            android:textColor="@color/accent_move"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/val_move"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/val_move_unit"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider1"
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:background="@color/chip_background" />

                    <!-- Métrica: Ejercicio -->
                    <LinearLayout
                        android:id="@+id/metric_exercise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_exercise"
                            android:textColor="@color/accent_exercise"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/val_exercise"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/val_exercise_unit"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divider2"
                        android:layout_width="1dp"
                        android:layout_height="30dp"
                        android:background="@color/chip_background" />

                    <!-- Métrica: Tiempo de pie -->
                    <LinearLayout
                        android:id="@+id/metric_stand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_stand"
                            android:textColor="@color/accent_stand"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/val_stand"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/val_stand_unit"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Chip de pasos -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_steps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/val_steps"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/chip_background"
                        app:chipIcon="@drawable/ic_shoe"
                        app:chipIconTint="@color/accent_green"
                        app:layout_constraintTop_toBottomOf="@id/flow_metrics"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón: compartir reporte -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_report"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="@string/share_report"
                android:textColor="@color/screen_background"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/accent_move"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconTint="@color/screen_background"
                app:layout_constraintTop_toBottomOf="@id/card_activity_rings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Botón: retorno global al menú -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_menu"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/back_to_main_menu"
                android:textColor="@color/accent_purple"
                android:textSize="15sp"
                app:strokeColor="@color/accent_purple"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconTint="@color/accent_purple"
                app:layout_constraintTop_toBottomOf="@id/btn_share_report"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra inferior: los ítems vienen de res/menu/bottom_nav_menu.xml -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>