<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base de la aplicación (Sin Action Bar para usar nuestro propio diseño) -->
    <style name="Theme.CuidApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Colores principales (referenciando tu colors.xml) -->
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/btn_purple</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorSecondaryVariant">@color/btn_green</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Fondos generales -->
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
    </style>
</resources>